# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Use local MongoDB or MongoDB Atlas placeholder)
MONGODB_URI=mongodb://127.0.0.1:27017/collabspace

# Authentication Secrets (Replace with a strong random secret in local .env)
JWT_SECRET=replace_with_your_own_secure_random_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend CORS Origin
CLIENT_ORIGIN=http://localhost:5173

# File Upload Limits
MAX_FILE_SIZE_MB=15
